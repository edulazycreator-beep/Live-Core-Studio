root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xaml,csproj,props,targets,json,slnf,manifest}]
indent_size = 2

[*.xaml]
indent_size = 4

[*.{ps1,sln}]
end_of_line = crlf

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
