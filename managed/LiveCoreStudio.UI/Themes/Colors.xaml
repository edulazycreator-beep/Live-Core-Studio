<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Live Core Studio palette: charcoal, graphite, white, signal orange. -->
    <Color x:Key="Color.Base">#FF111214</Color>
    <Color x:Key="Color.Surface">#FF1A1B1E</Color>
    <Color x:Key="Color.SurfaceRaised">#FF222327</Color>
    <Color x:Key="Color.SurfaceHover">#FF2A2C30</Color>
    <Color x:Key="Color.Border">#FF2F3136</Color>
    <Color x:Key="Color.TextPrimary">#FFF3F3F4</Color>
    <Color x:Key="Color.TextSecondary">#FFA2A5AB</Color>
    <Color x:Key="Color.TextMuted">#FF6C7076</Color>
    <Color x:Key="Color.Accent">#FFFF7A1A</Color>
    <Color x:Key="Color.AccentHover">#FFFF923F</Color>
    <Color x:Key="Color.AccentPressed">#FFE0650C</Color>
    <Color x:Key="Color.Success">#FF3CCB7F</Color>
    <Color x:Key="Color.Warning">#FFF5B83D</Color>
    <Color x:Key="Color.Danger">#FFF0524F</Color>

    <SolidColorBrush x:Key="Brush.Base" Color="{StaticResource Color.Base}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#26FF7A1A" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
