<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Original Live Core Studio glyphs, drawn on a 24×24 grid (stroke-based). -->

    <!-- Overview: one wide tile over two small tiles. -->
    <Geometry x:Key="Icon.Dashboard">M3,3 H21 V11 H3 Z M3,14 H10.5 V21 H3 Z M13.5,14 H21 V21 H13.5 Z</Geometry>

    <!-- Production: preview and program monitors over a transition bar. -->
    <Geometry x:Key="Icon.Production">M2,4 H11 V12 H2 Z M13,4 H22 V12 H13 Z M4,17 H20 M12,15 V19</Geometry>

    <!-- Engine health: signal trace through a frame. -->
    <Geometry x:Key="Icon.Diagnostics">M2,12 H7 L9.5,5 L14.5,19 L17,12 H22</Geometry>

    <!-- Settings: three faders at different levels. -->
    <Geometry x:Key="Icon.Settings">M5,3 V21 M12,3 V21 M19,3 V21 M2.5,15 H7.5 M9.5,7 H14.5 M16.5,12 H21.5</Geometry>

    <!-- Brand mark: a ring (live signal) with an offset core dot. -->
    <Geometry x:Key="Icon.BrandRing">M12,4 A8,8 0 1 1 11.99,4 Z</Geometry>
    <Geometry x:Key="Icon.BrandCore">M12,9 A3,3 0 1 1 11.99,9 Z</Geometry>

    <Geometry x:Key="Icon.Play">M7,4 L20,12 L7,20 Z</Geometry>
    <Geometry x:Key="Icon.Stop">M6,6 H18 V18 H6 Z</Geometry>
    <Geometry x:Key="Icon.Restart">M19,12 A7,7 0 1 1 16.95,7.05 M17,3 V7.05 H12.95</Geometry>
</ResourceDictionary>
