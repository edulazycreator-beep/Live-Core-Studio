<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:LiveCoreStudio.UI.Converters">
    <!-- Merge this one dictionary in App.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LiveCoreStudio.UI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/LiveCoreStudio.UI;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="/LiveCoreStudio.UI;component/Themes/Controls.xaml" />
        <ResourceDictionary Source="/LiveCoreStudio.UI;component/Views/ViewTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:EngineStateToBrushConverter x:Key="EngineStateToBrush" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />
</ResourceDictionary>
