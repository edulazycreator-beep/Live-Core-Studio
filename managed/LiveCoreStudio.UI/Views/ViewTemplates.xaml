<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:LiveCoreStudio.UI.ViewModels"
                    xmlns:views="clr-namespace:LiveCoreStudio.UI.Views">
    <!-- View-model-first navigation: the shell shows CurrentPage, WPF picks the view. -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProductionViewModel}">
        <views:ProductionView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
        <views:DiagnosticsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
</ResourceDictionary>
