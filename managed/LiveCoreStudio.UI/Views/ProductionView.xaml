<UserControl x:Class="LiveCoreStudio.UI.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LiveCoreStudio.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductionViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding CutCommand}" />
        <KeyBinding Key="Return" Command="{Binding AutoCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- A monitor: 16:9 picture with a tally-coloured frame. -->
        <DataTemplate x:Key="MonitorTemplate" DataType="{x:Type vm:MonitorViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label}" />
                <Border x:Name="Frame" BorderThickness="2" CornerRadius="4" Background="Black" BorderBrush="{StaticResource Brush.Border}">
                    <Grid>
                        <Viewbox Stretch="Uniform">
                            <Grid Width="640" Height="360">
                                <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
                                <TextBlock Text="NO SIGNAL" Foreground="{StaticResource Brush.TextMuted}" FontSize="22" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasSignal, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Label}" Value="PROGRAM">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Label}" Value="PREVIEW">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Bus button: number + name, lit when the source is on this bus. -->
        <Style x:Key="BusButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
        <StackPanel>
            <!-- Monitors -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Content="{Binding Preview}" ContentTemplate="{StaticResource MonitorTemplate}" Focusable="False" />
                <ContentControl Grid.Column="2" Content="{Binding Program}" ContentTemplate="{StaticResource MonitorTemplate}" Focusable="False" />
            </Grid>
            <TextBlock Text="{Binding PipelineInfo}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,8,0,0" />

            <!-- Switcher -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" IsEnabled="{Binding EngineReady}">
                <DockPanel>
                    <!-- Transition block -->
                    <StackPanel DockPanel.Dock="Right" Width="200" Margin="24,0,0,0">
                        <TextBlock Style="{StaticResource Text.Label}" Text="TRANSITION" />
                        <Button Style="{StaticResource Button.Base}" Content="CUT" Command="{Binding CutCommand}" Height="44" FontSize="15"
                                ToolTip="Swap Preview and Program instantly (Space)" />
                        <Button Style="{StaticResource Button.Primary}" Content="AUTO" Command="{Binding AutoCommand}" Height="44" FontSize="15" Margin="0,8,0,0"
                                ToolTip="Mix Preview into Program (Enter)" />
                        <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding TransitionPosition, Mode=OneWay}"
                                     Foreground="{StaticResource Brush.Accent}" Background="{StaticResource Brush.SurfaceRaised}" BorderThickness="0" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="ms" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Text="{Binding TransitionMs, ValidatesOnExceptions=True}" FontFamily="{StaticResource Font.Mono}" ToolTip="Mix duration" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="PROGRAM BUS — click to take straight to air" />
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceItemViewModel}">
                                    <Button x:Name="Btn" Style="{StaticResource BusButton}"
                                            Command="{Binding DataContext.SetProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Index}" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProgram}" Value="True">
                                            <Setter TargetName="Btn" Property="Background" Value="{StaticResource Brush.Danger}" />
                                            <Setter TargetName="Btn" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Text.Label}" Text="PREVIEW BUS — click to prepare the next shot" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceItemViewModel}">
                                    <Button x:Name="Btn" Style="{StaticResource BusButton}"
                                            Command="{Binding DataContext.SetPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Index}" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                            <Setter TargetName="Btn" Property="Background" Value="{StaticResource Brush.Success}" />
                                            <Setter TargetName="Btn" Property="Foreground" Value="#FF111214" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Margin="0,8,0,0"
                                   Text="No sources yet. Add a camera or a test pattern below."
                                   Visibility="{Binding Sources.Count, Converter={StaticResource ZeroToVisible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Warning}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />

            <!-- Sources -->
            <Grid Margin="0,20,0,0" IsEnabled="{Binding EngineReady}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="Sources" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SourceItemViewModel}">
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}" Content="Remove" Padding="10,4"
                                                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Width="90" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Resolution}" Width="90" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Foreground="{StaticResource Brush.TextPrimary}" FontSize="13">
                                                    <Run Text="{Binding Index, Mode=OneWay}" Foreground="{StaticResource Brush.Accent}" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Add camera" />
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="12" Margin="0,4,0,10" Text="USB webcams and HDMI/SDI capture cards with a Windows driver." />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}" Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshDevicesCommand}" />
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" />
                            </DockPanel>
                            <TextBlock Text="{Binding DeviceHint}" Style="{StaticResource Text.Body}" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{StaticResource Brush.TextMuted}" Visibility="{Binding DeviceHint, Converter={StaticResource NullToCollapsed}}" />
                            <Button Style="{StaticResource Button.Primary}" Content="Add camera" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding AddDeviceCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Add test pattern" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="NAME" Margin="0,12,0,4" />
                            <TextBox Text="{Binding NewPatternName, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="PATTERN" />
                                    <ComboBox ItemsSource="{Binding PatternKinds}" SelectedItem="{Binding NewPatternKind}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="COLOUR (SOLID)" />
                                    <TextBox Text="{Binding NewPatternColor, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" />
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource Button.Base}" Content="Add test pattern" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding AddTestPatternCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
